{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": [
    "/^main$|^\\d\\.[\\d]+$/"
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchBaseBranches": ["1.1", "1.2", "1.3", "1.4"]
