{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranches": ["/^main$|^1.\\d$/"],
    "packageRules": [
      {
        "enabled": false,
        "matchBaseBranches": ["1.1", "1.2"]
      },
      {
        "automerge": false
      }
    ],
    "tekton": {
      "enabled": false,
      "matchBaseBranches": ["1.1", "1.2"]
    },
    "git-submodules": {
      "enabled": false,
      "matchBaseBranches": ["/^1.\\d$/"]
    }
}
