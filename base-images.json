{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset for teams consuming AIPCC base images from quay.io/aipcc/base-images or registry.redhat.io/rhai. Detects base image references in CI configs and container files, and proposes updates using the AIPCC base image versioning scheme.",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".gitlab-ci.yml",
        "containerfiles/**",
        "**/Containerfile*",
        "**/Dockerfile*"
      ],
      "matchStrings": [
        "BASE_IMAGE_\\w+:\\s*\"(?<depName>(?:quay\\.io/aipcc/base-images|registry\\.redhat\\.io/rhai(?:-early-access)?)/[^:\"\\s]+):(?<currentValue>[^\"\\s]+)\"",
        "ARG\\s+BASE_IMAGE(?:_\\w+)?=(?<depName>(?:quay\\.io/aipcc/base-images|registry\\.redhat\\.io/rhai(?:-early-access)?)/[^:\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v?(?:(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:-(?:(?:EA|ea)(?<prerelease>\\d+)|stable))?[.-])?(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Enable and group AIPCC base image updates",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "quay.io/aipcc/base-images/**",
        "registry.redhat.io/rhai/base-image-*",
        "registry.redhat.io/rhai-early-access/base-image-*"
      ],
      "enabled": true,
      "groupName": "base-image",
      "ignoreUnstable": false
    }
  ]
}
