{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>platform-engineering-org/.github",
    "github>platform-engineering-org/.github//konflux.json",
    "gitlab>redhat/rhel-ai/renovate-config//base-branches.json",
    "group:all"
  ],
  "automerge": false,
  "schedule": ["at any time"],
  "packageRules": [
    {
      "matchPackageNames": [
        "registry.access.redhat.com/ubi9/ubi",
        "registry.redhat.io/ubi9/ubi"
      ],
      "allowedVersions": "/^9\\.4-[\\d.]+$/"
    }
  ]
}
